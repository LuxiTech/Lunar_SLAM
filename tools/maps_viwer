#!/usr/bin/env bash

# Unified, read-only map viewer.  The name intentionally follows the project
# command requested by users: maps_viwer.
set -euo pipefail

script_directory="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
workspace="$(cd "${script_directory}/.." && pwd)"
dry_run=false
check_display=false
color_view=false
both_view=false
map_path=""
runtime_directory=""
worker_pid=""
extra_worker_pid=""

usage() {
  cat <<'EOF'
Usage: maps_viwer [--dry-run] [--color|--both] MAP

Open a saved map in the appropriate read-only viewer:
  *.yaml, *.yml          2D occupancy-grid map (Nav2 map YAML)
  *.pgm, *.png           2D occupancy-grid image with a same-name YAML file
  *.db                   RTAB-Map database, exported to its 3D OccupancyMap view
  *.bt, *.ot             OctoMap / voxel map, displayed as 3D occupied voxels

--dry-run validates and reports the selected viewer without opening a GUI.
--color shows a .db file as RTAB-Map's colored RGB-D point-cloud map.
--both shows a .db file with both colored point cloud and OccupancyMap voxels.
--check-display validates the X11 configuration without opening a map.
EOF
}

error() {
  echo "maps_viwer: $*" >&2
  exit 2
}

cleanup() {
  local pid
  for pid in "${worker_pid}" "${extra_worker_pid}"; do
    if [[ -n "${pid}" ]] && kill -0 "${pid}" 2>/dev/null; then
      kill -INT "${pid}" 2>/dev/null || true
      wait "${pid}" 2>/dev/null || true
    fi
  done
  if [[ -n "${runtime_directory}" ]]; then
    rm -rf "${runtime_directory}"
  fi
}

load_ros_environment() {
  # ROS setup scripts read variables that are not defined under `set -u`.
  set +u
  source /opt/ros/humble/setup.bash
  source "${workspace}/install/setup.bash"
  source "${workspace}/device/D435i/ros2_ws/install/setup.bash"
  set -u
  export LD_LIBRARY_PATH="${workspace}/3parts/octomap/install/lib:${LD_LIBRARY_PATH:-}"
}

prepare_graphics_environment() {
  [[ -n "${DISPLAY:-}" ]] || error "DISPLAY is not set; run: export DISPLAY=:0 XAUTHORITY=/tmp/.docker.xauth QT_X11_NO_MITSHM=1"

  local display_number="${DISPLAY#:}"
  display_number="${display_number%%.*}"
  if [[ "${DISPLAY}" =~ ^:[0-9]+(\.[0-9]+)?$ ]] && [[ ! -S "/tmp/.X11-unix/X${display_number}" ]]; then
    if [[ -S /tmp/.X11-unix/X0 ]]; then
      echo "maps_viwer: DISPLAY=${DISPLAY} has no X11 socket; using DISPLAY=:0" >&2
      export DISPLAY=:0
    else
      error "X11 socket /tmp/.X11-unix/X${display_number} is unavailable; mount X11 and use DISPLAY=:0"
    fi
  fi
  if [[ -z "${XAUTHORITY:-}" && -r /tmp/.docker.xauth ]]; then
    export XAUTHORITY=/tmp/.docker.xauth
  fi
  export QT_X11_NO_MITSHM="${QT_X11_NO_MITSHM:-1}"
}

yaml_image_path() {
  local yaml_path="$1"
  python3 - "${yaml_path}" <<'PY'
from pathlib import Path
import sys
import yaml

path = Path(sys.argv[1]).resolve()
try:
    content = yaml.safe_load(path.read_text(encoding="utf-8"))
except (OSError, UnicodeDecodeError, yaml.YAMLError) as error:
    raise SystemExit(f"cannot read occupancy-grid YAML: {error}")
if not isinstance(content, dict) or not isinstance(content.get("image"), str):
    raise SystemExit("YAML has no string 'image' field")
image = Path(content["image"])
if not image.is_absolute():
    image = path.parent / image
if not image.is_file():
    raise SystemExit(f"referenced image does not exist: {image}")
print(image.resolve())
PY
}

