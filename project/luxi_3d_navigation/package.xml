<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>luxi_3d_navigation</name>
  <version>0.1.0</version>
  <description>Ground-supported 3D A* planning on saved OctoMaps.</description>
  <maintainer email="lunar@example.com">lunar</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>geometry_msgs</depend>
  <depend>libpcl-all-dev</depend>
  <depend>nav_msgs</depend>
  <depend>nlohmann-json3-dev</depend>
  <depend>octomap</depend>
  <depend>octomap_msgs</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <exec_depend>luxi_visual_frontend</exec_depend>
  <depend>visualization_msgs</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>luxi_hloc</exec_depend>
  <exec_depend>luxi_voxel_navigation</exec_depend>
  <exec_depend>rtabmap_odom</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
