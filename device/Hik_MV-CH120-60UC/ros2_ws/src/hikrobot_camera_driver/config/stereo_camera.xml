<?xml version="1.0" encoding="UTF-8"?>
<!-- Edit this file, then restart stereo_node for the changes to take effect. -->
<stereo_camera>
  <left_camera 
  serial="DA7672183" 
  />
  
  <right_camera 
  serial="DB0431802" 
  />

  <!-- Use the trigger selector, Line0 polarity, and source saved in MVS UserSet1. -->
  <acquisition 
  user_set="UserSet1" 
  external_trigger="true" 
  trigger_source="Default" 
  frame_rate_hz="0.0" />

  <!-- Fixed exposure for consistent stereo brightness: 25000 us = 25 ms. -->
  <exposure 
  auto="false" 
  time_us="25000"
  />

  <gain 
  auto="false"
  value="23.8" 
  />
  
  <image 
  pixel_format="Default" 
  width="0" height="0" 
  offset_x="0" 
  offset_y="0"
  binning_horizontal="1" 
  binning_vertical="1"
  decimation_horizontal="1" 
  decimation_vertical="1"
  swap_red_blue="true" 
  override_white_balance="false"
  auto_white_balance="false" 
  />

</stereo_camera>
