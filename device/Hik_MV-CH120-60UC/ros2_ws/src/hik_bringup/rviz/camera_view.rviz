Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Left Camera
      Normalize Range: false
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Transport Override: compressed
        Value: /stereo/preview/left_color
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Right Camera
      Normalize Range: false
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Transport Override: compressed
        Value: /stereo/preview/right_color
  Enabled: true
  Global Options:
    Background Color: 32; 32; 32
    Fixed Frame: map
    Frame Rate: 25
  Name: root
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
Window Geometry:
  Height: 900
  Width: 1600
  X: 50
  Y: 50
