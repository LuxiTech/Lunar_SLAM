<?xml version="1.0" encoding="UTF-8"?>
<!-- Edit this file, then restart stereo_node for the changes to take effect. -->
<stereo_camera>
  <left_camera 
  serial="DA7672183" 
  />
  
  <right_camera 
  serial="DB0431802" 
  />

  <!-- trigger_source="Default" keeps the source saved in MVS. -->
  <acquisition 
  user_set="UserSet1" 
  external_trigger="false" 
  trigger_source="Default" 
  frame_rate_hz="0.0" />

  <!-- time_us is only applied when auto="false"; 10000 us = 10 ms. -->
  <exposure 
  auto="false" 
  time_us="30000"
  />

  <gain 
  auto="false"
  value="23.8" 
  />
  
  <image 
  pixel_format="Default" 
  width="0" height="0" 
  offset_x="0" 
  offset_y="0"
  binning_horizontal="1" 
  binning_vertical="1"
  decimation_horizontal="1" 
  decimation_vertical="1"
  swap_red_blue="true" 
  auto_white_balance="true" 
  />

</stereo_camera>
